RUSHLINE_DATABASE_URL=postgresql+asyncpg://rushline:rushline@localhost:5432/rushline
RUSHLINE_REDIS_URL=redis://localhost:6379/0
RUSHLINE_HOLD_TTL_SECONDS=600
RUSHLINE_MAX_SEATS_PER_HOLD=6
# Generate your own: python -c "import secrets; print(secrets.token_urlsafe(48))"
RUSHLINE_JWT_SECRET=change-me-to-a-random-string-of-at-least-32-chars
RUSHLINE_ENABLE_DEV_LOGIN=true
